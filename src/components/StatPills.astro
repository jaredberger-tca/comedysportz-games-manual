---
const { items = [] } = Astro.props;
---

<div class="stats">
  {items.map((item) => (
    <span>{item}</span>
  ))}
</div>

<style>
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }

  .stats span {
    display: inline-flex;
    border-radius: 999px;
    background: #e8efff;
    color: #1e3a8a;
    padding: 8px 14px;
    font-size: 0.9rem;
    font-weight: 750;
  }
</style>