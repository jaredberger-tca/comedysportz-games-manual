---
const { game } = Astro.props;
---

<a class="game-card" href={`/games/${game.slug}/`}>
  <strong>{game.title}</strong>

  {game.sourcePages ? (
    <small>Manual Page {game.sourcePages}</small>
  ) : (
    <small>Game Details</small>
  )}

  <span>→</span>
</a>

<style>
  .game-card {
    position: relative;
    display: block;
    border: 1px solid #e4e4e7;
    border-radius: 12px;
    padding: 18px 46px 18px 18px;
    background: #fafafa;
    color: #18181b;
    min-height: 72px;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease;
  }

  .game-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
    border-color: #bfd0ff;
    background: #f4f7ff;
    text-decoration: none;
  }

  .game-card strong {
    display: block;
  }

  .game-card small {
    display: block;
    margin-top: 5px;
    color: #71717a;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .game-card span {
    position: absolute;
    right: 18px;
    bottom: 16px;
    color: #005bbb;
  }
</style>