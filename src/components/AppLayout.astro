---
import AppNav from './AppNav.astro';

const { title = 'ComedySportz Games Manual' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title} | ComedySportz Games Manual</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body>
    <AppNav />

    <div class="beta-banner">
      🚧 <strong>Beta Preview</strong> — You're viewing an early version of the
      ComedySportz Games Manual. We're actively improving it and welcome your
      feedback!
    </div>

    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: #f7f7f8;
    color: #18181b;
    line-height: 1.6;
  }

  a {
    color: #005bbb;
    text-decoration: none;
    font-weight: 650;
  }

  a:hover {
    text-decoration: none;
  }

  .beta-banner {
  max-width: 1120px;
  margin: 18px auto 0;
  padding: 14px 18px;
  border-radius: 14px;
  background: #fff7d6;
  border: 1px solid #f2d675;
  color: #6b5200;
  font-size: 0.95rem;
  line-height: 1.5;
  box-sizing: border-box;
  display: block;
}

.beta-banner strong {
  font-weight: 800;
}

@media (max-width: 760px) {
  .beta-banner {
    margin: 12px 16px 0;
  }
}
</style>