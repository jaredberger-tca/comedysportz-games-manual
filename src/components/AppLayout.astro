---
import AppNav from './AppNav.astro';
import games from '../data/games.json';

const { title = 'ComedySportz Games Manual' } = Astro.props;

const gameCount = games.filter(
  (game) => game?.title && game?.slug
).length;

const lastUpdated = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'America/Chicago',
}).format(new Date());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title} | ComedySportz Games Manual</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body>
    <AppNav />

    <div class="beta-banner">
      🚧 <strong>Beta Preview</strong> — You're viewing an early version of the
      ComedySportz Games Manual. We're actively improving it and welcome your
      feedback!
    </div>

    <slot />

    <footer class="site-footer">
      <div class="footer-content">
        <h2>About This Database</h2>

        <p class="footer-lead">
          The ComedySportz Games Database is maintained by ComedySportz Worldwide
          to preserve, organize, and share the collective knowledge of the
          ComedySportz community.
        </p>

        <p>
          This living resource has been built through the contributions of players,
          referees, coaches, and managers from leagues across the world. It exists
          to support the continued growth, consistency, and success of ComedySportz.
        </p>

        <p>
          Please help us honor the many contributors who have shared their ideas by
          treating this as a community resource and not redistributing its contents
          outside of ComedySportz without permission from ComedySportz Worldwide.
        </p>

        <p class="database-status">
          Version 1.0
          <span aria-hidden="true">•</span>
          {gameCount} Games
          <span aria-hidden="true">•</span>
          Last Updated {lastUpdated}
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: #f7f7f8;
    color: #18181b;
    line-height: 1.6;
  }

  a {
    color: #005bbb;
    text-decoration: none;
    font-weight: 650;
  }

  a:hover {
    text-decoration: none;
  }

  .beta-banner {
    max-width: 1120px;
    margin: 18px auto 0;
    padding: 14px 18px;
    border-radius: 14px;
    background: #fff7d6;
    border: 1px solid #f2d675;
    color: #6b5200;
    font-size: 0.95rem;
    line-height: 1.5;
    box-sizing: border-box;
    display: block;
  }

  .beta-banner strong {
    font-weight: 800;
  }

  .site-footer {
    max-width: 1120px;
    margin: 48px auto 0;
    padding: 0 20px 40px;
    box-sizing: border-box;
  }

  .footer-content {
    padding: 28px;
    background: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 18px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    color: #3f3f46;
    line-height: 1.65;
  }

  .footer-content h2 {
    margin: 0 0 14px;
    color: #18181b;
    font-size: 1.35rem;
  }

  .footer-content p {
    margin: 0 0 14px;
  }

  .footer-lead {
    color: #27272a;
    font-weight: 650;
  }

  .database-status {
    margin: 24px 0 0 !important;
    padding-top: 18px;
    border-top: 1px solid #e4e4e7;
    color: #71717a;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
  }

  .database-status span {
    padding: 0 8px;
  }

  @media (max-width: 760px) {
    .beta-banner {
      margin: 12px 16px 0;
    }

    .site-footer {
      margin-top: 32px;
      padding: 0 16px 28px;
    }

    .footer-content {
      padding: 22px;
    }

    .database-status span {
      padding: 0 4px;
    }
  }
</style>