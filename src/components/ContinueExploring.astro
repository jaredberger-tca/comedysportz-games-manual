---
const {
  links = [
    { href: "/browse-games/", label: "Browse All Games" },
    { href: "/search/", label: "Find a Game" },
    { href: "/browse-games/#browse-by-type", label: "Browse by Type" },
    { href: "/browse-games/#browse-by-category", label: "Browse by Category" },
    { href: "/", label: "Home" },
  ],
} = Astro.props;
---

<section class="continue">
  <h2>Continue Exploring</h2>

  <div class="explore-links">
    {links.map((link) => (
      <a href={link.href}>{link.label} →</a>
    ))}
  </div>
</section>

<style>
  .continue {
    background: white;
    border: 1px solid #e4e4e7;
    border-radius: 18px;
    padding: 32px;
    margin-top: 32px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  }

  .continue h2 {
    margin-top: 0;
    margin-bottom: 18px;
  }

  .explore-links {
    display: grid;
    gap: 12px;
  }

  .explore-links a {
    display: block;
    border: 1px solid #e4e4e7;
    border-radius: 12px;
    padding: 16px 18px;
    background: #fafafa;
    color: #18181b;
    text-decoration: none;
    font-weight: 650;
  }

  .explore-links a:hover {
    background: #f4f7ff;
    border-color: #bfd0ff;
    color: #005bbb;
  }
</style>